{
  "name": "@stackline/uglify-js",
  "description": "Maintained UglifyJS 2 compatibility fork with legacy CLI and synchronous minify API",
  "homepage": "https://github.com/alexandroit/stackline-uglify-js#readme",
  "author": "Mihai Bazon <mihai.bazon@gmail.com> (http://lisperator.net/)",
  "license": "BSD-2-Clause",
  "version": "1.0.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-uglify-js.git"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-uglify-js/issues"
  },
  "main": "tools/node.js",
  "bin": {
    "uglifyjs": "bin/uglifyjs"
  },
  "files": [
    "bin",
    "lib",
    "tools",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.md",
    "README.upstream.md"
  ],
  "dependencies": {
    "async": "^3.2.6",
    "source-map-js": "^1.2.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {},
  "browserify": {
    "transform": [
      "./tools/browserify.js"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "npm test",
    "prepack": "npm test"
  },
  "keywords": [
    "uglify",
    "uglify-js",
    "minify",
    "minifier"
  ],
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "acorn": "^8.18.0"
  }
}
