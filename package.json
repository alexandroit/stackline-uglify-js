{
  "name": "@stackline/uglify-js",
  "description": "UglifyJS 2-compatible JavaScript minification with a synchronous API and legacy command-line options",
  "homepage": "https://alexandro.net/docs/vanilla/uglify-js/",
  "author": "Mihai Bazon <mihai.bazon@gmail.com> (http://lisperator.net/)",
  "license": "BSD-2-Clause",
  "version": "1.0.4",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-uglify-js.git"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-uglify-js/issues"
  },
  "main": "tools/node.js",
  "bin": {
    "uglifyjs": "bin/uglifyjs"
  },
  "files": [
    "bin",
    "lib",
    "tools",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.md",
    "README.upstream.md",
    "CHANGELOG.md",
    "DEPENDENCY_UPDATES.md"
  ],
  "dependencies": {
    "async": "npm:@stackline/async@1.0.0",
    "source-map-js": "npm:@stackline/source-map-js@1.0.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {},
  "browserify": {
    "transform": [
      "./tools/browserify.js"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "npm test",
    "prepack": "npm test",
    "test:package": "node scripts/test-package.mjs"
  },
  "keywords": [
    "stackline",
    "npm-package",
    "uglify-js",
    "javascript",
    "nodejs",
    "uglify",
    "minify",
    "minifier",
    "uglifyjs",
    "compressor",
    "source-map",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "acorn": "^8.18.0"
  }
}
